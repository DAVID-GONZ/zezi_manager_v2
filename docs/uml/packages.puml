@startuml ZECI_Packages
!theme plain
title ZECI Manager v2.0 — Diagrama de Paquetes

skinparam packageStyle rectangle
skinparam defaultFontName Inter
skinparam defaultFontSize 12
skinparam ArrowColor #475569
skinparam PackageBorderColor #CBD5E1

' ── Capas ──────────────────────────────────────────
package "domain.models" as domain_models #DBEAFE {
}
package "domain.ports" as domain_ports #EDE9FE {
}
package "services" as services #D1FAE5 {
}
package "infrastructure.db" as infrastructure_db #FEF3C7 {
}
package "infrastructure.auth" as infrastructure_auth #FEF3C7 {
}
package "infrastructure.context" as infrastructure_context #FEF3C7 {
}
package "interface.pages" as interface_pages #F3F4F6 {
}
package "interface.design" as interface_design #F3F4F6 {
}

' ── Dependencias detectadas con AST ────────────────
domain_ports --> domain_models
services --> domain_models
services --> domain_ports
infrastructure_db --> domain_models
infrastructure_db --> domain_ports
infrastructure_auth --> domain_models
infrastructure_auth --> domain_ports
interface_pages --> interface_design
interface_pages --> services
interface_design --> domain_models

@enduml